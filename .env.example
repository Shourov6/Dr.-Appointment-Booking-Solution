# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
SHOW_DEMO_CREDENTIALS=True
# Demo-only password displayed while DEBUG is enabled.
DEMO_LOGIN_PASSWORD=DemoLogin123!

# Database Configuration
# For Supabase PostgreSQL (recommended):
# Copy the connection string from Supabase > Project Settings > Database > Connect.
# Prefer Session Pooler for hosted applications.
# DB_ENGINE=django.db.backends.postgresql
# DATABASE_URL=postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@HOST:5432/postgres
# DB_SSLMODE=require

# For PostgreSQL using separate variables:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=postgres
# DB_USER=postgres.PROJECT_REF
# DB_PASSWORD=your-database-password
# DB_HOST=your-project-ref.pooler.supabase.com
# DB_PORT=5432
# DB_SSLMODE=require

# For SQLite (local development):
DB_ENGINE=django.db.backends.sqlite3

# For MySQL (production):
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=drseba_healthcare
# DB_USER=drseba_user
# DB_PASSWORD=your-database-password
# DB_HOST=localhost
# DB_PORT=3306

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Payment Gateway Settings (for production)
BKASH_APP_KEY=your-bkash-key
BKASH_APP_SECRET=your-bkash-secret
NAGAD_MERCHANT_ID=your-nagad-id
